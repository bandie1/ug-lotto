datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum RoundStatus {
  OPEN
  DRAWING
  COMPLETED
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  TICKET_PURCHASE
  LOTTERY_PAYOUT
}

enum TransactionStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id            String        @id @default(uuid())
  email         String        @unique
  walletAddress String?       @unique
  passwordHash  String
  role          Role          @default(USER)
  status        UserStatus    @default(ACTIVE)
  balance       Decimal       @default(0.00) @db.Decimal(18, 2)

  tickets       Ticket[]
  transactions  Transaction[]

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@map("users")
}

model Round {
  id               String      @id @default(uuid())
  roundNumber      Int         @unique @default(autoincrement())
  status           RoundStatus @default(OPEN)
  winningDigits    String?     @db.VarChar(6)
  
  ticketPrice      Decimal     @default(5.00) @db.Decimal(18, 2)
  grossSales       Decimal     @default(0.00) @db.Decimal(18, 2)
  adminFee         Decimal     @default(0.00) @db.Decimal(18, 2)
  rolloverFromPrev Decimal     @default(0.00) @db.Decimal(18, 2)

  tickets          Ticket[]

  createdAt        DateTime    @default(now())
  completedAt      DateTime?

  @@index([status])
  @@map("rounds")
}

model Ticket {
  id             String   @id @default(uuid())
  digits         String   @db.VarChar(6)
  matchedBracket Int      @default(0)
  payout         Decimal  @default(0.00) @db.Decimal(18, 2)

  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  roundId        String
  round          Round    @relation(fields: [roundId], references: [id], onDelete: Cascade)

  createdAt      DateTime @default(now())

  @@index([roundId])
  @@index([userId])
  @@index([roundId, digits])
  @@map("tickets")
}

model Transaction {
  id           String            @id @default(uuid())
  amount       Decimal           @db.Decimal(18, 2)
  type         TransactionType
  status       TransactionStatus @default(PENDING)
  paymentProof String?
  adminNote    String?

  userId       String
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  approvedBy   String?

  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([userId])
  @@index([status, type])
  @@map("transactions")
}

model SystemStats {
  id                Int      @id @default(1)
  totalAdminRevenue Decimal  @default(0.00) @db.Decimal(18, 2)
  updatedAt         DateTime @updatedAt

  @@map("system_stats")
}